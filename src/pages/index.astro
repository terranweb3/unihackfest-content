---
import BaseLayout from "../layouts/BaseLayout.astro";
import { localizedPath, ui } from "../lib/i18n";

const lang = "en";
const labels = ui[lang];
---

<BaseLayout title={labels.title} lang={lang}>
  <main class="min-h-dvh">
    <section class="mx-auto grid min-h-dvh max-w-6xl content-center gap-10 px-4 py-12 sm:px-6 lg:grid-cols-[1fr_360px] lg:items-center">
      <div>
        <p class="text-sm font-bold uppercase tracking-[0.18em] text-sky-700">
          {labels.eyebrow}
        </p>
        <h1 class="mt-4 max-w-3xl text-4xl font-black tracking-tight text-slate-950 sm:text-6xl">
          {labels.title}
        </h1>
        <p class="mt-5 max-w-2xl text-lg leading-8 text-slate-600">
          {labels.intro}
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href={localizedPath("/plan", lang)}
            class="inline-flex h-11 items-center rounded-[8px] bg-slate-950 px-5 text-sm font-bold text-white transition hover:bg-slate-800 focus:outline-none focus:ring-4 focus:ring-slate-300"
          >
            {labels.openPlan}
          </a>
          <a
            href={localizedPath("/plan/intro", lang)}
            class="inline-flex h-11 items-center rounded-[8px] border border-slate-300 bg-white px-5 text-sm font-bold text-slate-800 transition hover:border-slate-400 hover:bg-slate-50 focus:outline-none focus:ring-4 focus:ring-slate-200"
          >
            {labels.readIntro}
          </a>
        </div>
      </div>

      <div class="rounded-[8px] border border-slate-200 bg-white p-5 shadow-sm">
        <div class="text-sm font-bold uppercase tracking-[0.14em] text-slate-500">
          {labels.snapshot}
        </div>
        <dl class="mt-5 grid grid-cols-2 gap-4">
          <div class="rounded-[8px] bg-slate-50 p-4">
            <dt class="text-sm font-medium text-slate-600">{labels.sections}</dt>
            <dd class="mt-1 text-3xl font-black text-slate-950">23</dd>
          </div>
          <div class="rounded-[8px] bg-sky-50 p-4">
            <dt class="text-sm font-medium text-slate-600">{labels.year}</dt>
            <dd class="mt-1 text-3xl font-black text-slate-950">2026</dd>
          </div>
        </dl>
        <p class="mt-5 border-t border-slate-200 pt-5 text-sm leading-6 text-slate-600">
          {labels.snapshotBody}
        </p>
      </div>
    </section>
  </main>
</BaseLayout>
